# Rust build output. Cargo.lock stays committed: sqlh is a binary, so builds must be reproducible.
/target/

# rustfmt backups; coverage and mutation-testing output
**/*.rs.bk
*.profraw
*.profdata
lcov.info
mutants.out*/

# MSVC debug symbols and incremental-link files built outside target/
*.pdb
*.ilk

# sqlh connection profiles: they normally live in %APPDATA%, but SQLH_CONFIG can point
# anywhere. They hold server names and logins (never passwords), so keep them out of git.
profiles.toml
profiles.toml.lock
profiles.toml.*.partial

# Disposable experiments and local query results; these may contain real server data.
# Durable examples and test fixtures belong in docs/ or tests/, with synthetic data.
/scratch/
/artifacts/
# Release workflow output (PLAN.md 3.6), if it is run locally.
/dist/
/THIRD-PARTY-NOTICES.html

# Local-only material that is never pushed: the external code reviews (archive/reviews/).
/archive/

# Worktrees that Claude Code and its workflows create inside the checkout.
.claude/worktrees/

# Editors and IDEs
.vscode/
.idea/
.vs/
*.swp
*~

# Personal Claude Code settings (shared settings in .claude/settings.json stay tracked)
.claude/settings.local.json

# Codex runtime state if CODEX_HOME is placed inside the checkout.
# Keep AGENTS.md, .agents/skills/, and shared .codex/config.toml, rules and hooks trackable.
.codex/auth.json
.codex/history.jsonl
.codex/sessions/
.codex/archived_sessions/
.codex/log/
.codex/shell_snapshots/
.codex/tmp/
.codex/*.sqlite*
.codex/plugins/cache/
# An explicitly separate, repository-local Codex home is entirely machine-local.
/.codex-home/

# OS clutter
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
